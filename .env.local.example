# Copy this file to .env.local.

# Enables real AI document validation. Without it, the app runs in demo mode
# (upload works, results are clearly-labeled placeholders).
ANTHROPIC_API_KEY=

# Enables sign-in + persistent history (Supabase project settings ->
# Project Settings -> API). Without these, /cuenta shows a "not configured"
# message and document validation still works, just without saving anything.
# After setting these, run the SQL in supabase/migrations/0001_init.sql
# against your project (SQL Editor, or `supabase db push` via the CLI).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build the magic-link redirect URL. Set to your real deployed URL
# in production (e.g. https://tramitofacil.example.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
